# Đường dẫn đến các file PDF cần xử lý
PDF_GLOB=data/documents/duoc-thu-quoc-gia-viet-nam-2018.pdf

# Qdrant lưu trữ vector cục bộ
QDRANT_DIR=qdrant_db
COLLECTION_NAME=duoc_2018_v2
# Collection cũ (chunk theo trang) - chỉ dùng để so sánh trong evaluation/run_eval.py
BASELINE_COLLECTION=duoc_2018_pdf

# Số đoạn tài liệu đưa vào ngữ cảnh / số ứng viên mỗi nguồn trước khi xếp hạng
TOP_K=5
CANDIDATE_K=30
# Ngưỡng cosine khi câu hỏi không nêu tên thuốc (thấp hơn -> không gọi LLM)
MIN_SCORE=0.45

# Địa chỉ Ollama (không kèm /v1, code tự thêm khi cần). Máy khác: http://<IP>:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model dùng cho embedding và sinh câu trả lời
EMBEDDING_MODEL=bge-m3:latest
GENERATION_MODEL=qwen3:14b

# ===== Mô hình trả lời: ollama | gemini | openai =====
# Embedding vẫn luôn dùng Ollama để khớp chỉ mục đã tạo.
LLM_PROVIDER=ollama

# Google Gemini - dán key vào sau dấu = (không dùng ngoặc kép)
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI hoặc endpoint tương thích OpenAI (Groq, OpenRouter, DeepSeek...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Giao diện & prompt theo tài liệu (không cần sửa code) =====
APP_TITLE=💊 Tra cứu Dược thư Quốc gia
APP_SUBTITLE=Trợ lý tra cứu thông tin thuốc dựa trên Dược thư Quốc gia Việt Nam 2018
APP_NOTICE=Thông tin được truy xuất từ Dược thư Quốc gia Việt Nam 2018 để hỗ trợ tra cứu. Không thay thế chỉ định của bác sĩ hoặc tư vấn của dược sĩ.
# Bỏ trống để dùng prompt chung cho mọi tài liệu
SYSTEM_PROMPT_FILE=prompts/duoc_thu.txt

# ===== Backend (P1) =====
# Thư mục dữ liệu chạy (lịch sử chat, cấu hình runtime)
STORAGE_DIR=storage
# Địa chỉ backend FastAPI mà giao diện Streamlit gọi tới
BACKEND_URL=http://127.0.0.1:8000
# Khoá API quản trị – đặt một chuỗi ngẫu nhiên dài. P2 thay bằng đăng nhập nhân sự.
ADMIN_TOKEN=
# Khoá ký token đăng nhập nhân sự – chuỗi ngẫu nhiên dài; đổi khoá = mọi người phải đăng nhập lại
AUTH_SECRET=
